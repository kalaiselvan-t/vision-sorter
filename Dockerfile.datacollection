# Start with an official ROS 2 base image for the desired distribution
FROM ros:humble-ros-base

# Metadata labels for documentation
LABEL maintainer="your-email@example.com"
LABEL description="ROS 2 Humble development environment for Franka robot with MoveIt and Gazebo"
LABEL version="1.0"

# Set environment variables
# DEBIAN_FRONTEND=noninteractive: Prevents apt from prompting during build
# LANG/LC_ALL: Ensures proper UTF-8 encoding for internationalization
# ROS_DISTRO: Makes ROS version available to scripts and builds
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    ROS_DISTRO=humble

# Build arguments for user configuration
# These allow matching container user UID/GID to host user for proper file permissions
# with volume mounts. Override via docker-compose args or --build-arg
ARG USER_UID=1001
ARG USER_GID=1001
ARG USERNAME=user

# ============================================================================
# LAYER: Install all packages in one go (optimizes layer caching)
# ============================================================================
# Strategy: Install stable/common packages that rarely change to maximize
# Docker layer cache reuse. Package-specific dependencies will be handled
# by rosdep at runtime (see entrypoint script).
# ============================================================================

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    # Essential development tools (minimized for smaller image)
    bash-completion \
    curl \
    git \
    sudo \
    # ROS build and development tools
    python3-colcon-argcomplete \
    python3-colcon-common-extensions \
    python3-vcstool \
    # Gazebo simulation packages
    ros-humble-ros-gz \
    ros-humble-sdformat-urdf \
    libignition-gazebo6-dev \
    libignition-plugin-dev \
    # Visualization and GUI
    ros-humble-rviz2 \
    ros-humble-moveit-ros-visualization \
    # MoveIt motion planning stack
    ros-humble-moveit-ros-move-group \
    ros-humble-moveit-kinematics \
    ros-humble-moveit-planners-ompl \
    ros-humble-moveit-simple-controller-manager \
    # ros2_control framework (core packages only, no testing tools)
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-ros2controlcli \
    ros-humble-controller-manager \
    ros-humble-controller-interface \
    ros-humble-hardware-interface \
    ros-humble-control-msgs \
    ros-humble-joint-state-broadcaster \
    ros-humble-joint-trajectory-controller \
    # Essential utilities
    ros-humble-joint-state-publisher \
    ros-humble-xacro \
    ros-humble-realtime-tools \
    ros-humble-generate-parameter-library \
    # Python packages for data collection
    python3-pip \
    python3-opencv \
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    postgresql-client \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages for data collection pipeline
RUN pip3 install --no-cache-dir \
    minio \
    psycopg2-binary \
    opencv-python \
    numpy \
    h5py \
    pyyaml

# ============================================================================
# LAYER: User setup
# ============================================================================
# Creates a non-root user for security and file permission matching with host.
# NOPASSWD sudo allows seamless package installation during development.
# Bashrc setup ensures ROS environment is sourced on shell startup.
# ============================================================================

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME -s /bin/bash \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
    && echo "source /opt/ros/$ROS_DISTRO/setup.bash" >> /home/$USERNAME/.bashrc \
    && echo "source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash" >> /home/$USERNAME/.bashrc

# ============================================================================
# LAYER: Copy entrypoint and set permissions
# ============================================================================
# The entrypoint script runs at container startup to:
# 1. Import external repositories via vcs (franka_description, libfranka, etc.)
# 2. Install dependencies via rosdep for all packages in workspace
# This runtime approach keeps dependencies in sync with mounted source code.
# ============================================================================

# ============================================================================
# LAYER: Final configuration
# ============================================================================
# Switch to non-root user for security and proper file ownership.
# All subsequent commands and container processes run as this user.
# ============================================================================

USER $USERNAME
WORKDIR /

# Container configuration
CMD [ "/bin/bash" ]

# ============================================================================
# DOCKER COMPOSE NOTES
# ============================================================================
# This image is designed to work with privileged mode and host networking:
#
# - privileged: true
#   Required for direct hardware access to Franka robot controllers and
#   real-time communication. Grants container access to all host devices.
#   SECURITY NOTE: Only use in trusted development environments.
#
# - network_mode: "host"
#   Needed for ROS 2 DDS discovery and low-latency robot communication.
#   Container shares host's network stack.
#
# - pid: host
#   Allows real-time process scheduling for robot control loops.
#
# - volumes: ./:/ros2_ws/src
#   Mounts your source code into container for live development.
#   File permissions match due to USER_UID/USER_GID configuration.
# ============================================================================